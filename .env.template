# Reachy Mini Demo — Environment Variables
#
# Copy to .env and fill in values:
#   cp .env.template .env

# Remote Reachy daemon IP (empty = localhost / auto-discover via Zenoh)
REACHY_HOST=

# Enable proactive booth greetings (1 = on, empty = off)
BOOTH_MODE=

# Enable UDP state broadcast for dual-robot mode (1 = on, empty = off)
REACHY_BROADCAST=
