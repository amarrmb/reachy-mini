# Reachy Mini Demo — Environment Variables
#
# Copy to .env and fill in values:
#   cp .env.template .env

# Remote Reachy daemon IP (empty = localhost / auto-discover via Zenoh)
REACHY_HOST=

# Enable proactive booth greetings (1 = on, empty = off)
BOOTH_MODE=

# Enable UDP state broadcast for dual-robot mode (1 = on, empty = off)
REACHY_BROADCAST=

# UDP broadcast port for dual-robot state sync (default: 5555)
REACHY_BROADCAST_PORT=

# Seconds of silence before idle look-around animation (default: 45)
BOOTH_IDLE_ANIM_S=

# Seconds of silence before spoken greeting (default: 90)
BOOTH_GREET_S=
