# Reachy Mini conversation app — DeviceNexus deployment.
#
# All inference is on-LAN (no cloud), split across two boxes:
#   - Reachy Pi5: STT (distil-whisper), TTS (Kokoro), VAD, audio I/O,
#                 motion via the daemon, fastrtc orchestrator
#   - Jetson Thor (10.0.0.2): vLLM (Qwen2.5-VL-7B-Instruct-NVFP4) for the LLM
#
# Pointing the LM Studio endpoint at Thor's vLLM works because both speak
# the OpenAI-compatible /v1 chat/completions API.

FULL_LOCAL_MODE=true
JETSON_OPTIMIZE=false   # Pi5 has no CUDA — disable Jetson-specific opt paths

# === LLM: Thor's vLLM via OpenAI-compatible endpoint ============================
LLM_PROVIDER=lmstudio
LMSTUDIO_ENDPOINT=http://10.0.0.2:8001/v1
LMSTUDIO_MODEL=nvidia/Qwen2.5-VL-7B-Instruct-NVFP4

# === STT: distil-whisper local on Pi5 ===========================================
DISTIL_WHISPER_MODEL=distil-whisper/distil-small.en
WHISPER_LANGUAGE=en

# === TTS: Kokoro local on Pi5, voice picked to match our previous config ========
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# === VAD ========================================================================
VAD_ENERGY_THRESHOLD=0.015
VAD_SILENCE_DURATION=0.5
VAD_MIN_SPEECH_DURATION=0.3

# === ONNX runtime — Pi5 has no CUDA, force CPU ==================================
ONNX_PROVIDERS=CPUExecutionProvider

# === Vision (optional) ==========================================================
# LOCAL_VISION_MODEL is only loaded if you pass --local-vision; we leave it off
# and let the LLM (Qwen2.5-VL on Thor) handle vision when needed.

# === HF cache: spill to /var/cache to save rootfs space =========================
HF_HOME=/home/pollen/.cache/huggingface
HF_TOKEN=

# === Personality: load our custom DeviceNexus character profile =================
REACHY_MINI_CUSTOM_PROFILE=curious_reachy
